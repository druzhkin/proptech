# Required for Perplexity news collection in `src/collect.py`
PERPLEXITY_API_KEY=pplx-...

# Required for YouTube monitoring in `src/collect.py` and `src/find_channels.py`
YOUTUBE_API_KEY=AIza...

# Required for OpenRouter-based draft generation in `src/generate.py`
OPENROUTER_API_KEY=sk-or-...

# Optional model override for OpenRouter, default is `anthropic/claude-sonnet-4`
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Required for the Telegram review/publish bot in `src/bot.py`
TG_BOT_TOKEN=

# Target Telegram channel username or chat ID for publish actions from `src/bot.py`
TG_CHANNEL_ID=@proptech_russia

# Optional pinned Telegram admin user ID. If empty, `bot.py` will authorize
# real channel administrators dynamically via Telegram `getChatMember`.
TG_ADMIN_ID=

# Optional built-in scheduler for the long-running bot service. Enable this in
# Railway if the same service should auto-run `collect -> generate`.
PIPELINE_SCHEDULER_ENABLED=0

# Polling interval for the built-in scheduler, in minutes.
PIPELINE_INTERVAL_MINUTES=180

# Whether the scheduler should run one pipeline pass immediately on process start.
PIPELINE_RUN_ON_START=1
