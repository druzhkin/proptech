# Required for Perplexity news collection in `src/collect.py`
PERPLEXITY_API_KEY=pplx-...

# Required for YouTube monitoring in `src/collect.py` and `src/find_channels.py`
YOUTUBE_API_KEY=AIza...

# Required for Claude-based draft generation in `src/generate.py`
ANTHROPIC_API_KEY=sk-ant-...

# Required for the Telegram review/publish bot in `src/bot.py`
TG_BOT_TOKEN=

# Target Telegram channel username or chat ID for publish actions from `src/bot.py`
TG_CHANNEL_ID=@proptech_russia

# Telegram admin user ID allowed to use `/drafts`, `/status`, Publish/Edit/Skip
TG_ADMIN_ID=
